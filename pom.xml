<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.schoste.ddd.domain</groupId>
    <artifactId>domain-repository3</artifactId>
    <version>3.0.0.RELEASE</version>
    <name>Domain Repository 3</name>
    <description>
        Domain Repository 3: repositories which create, provide and track the entities of an application, and Units of Work
        which write their changes to a storage, through a DAO of the DAO 4 library (dao4). Java 8 and later, no framework needed.
        Documentation: the README of the GitHub repository and the Javadoc jar (start with its overview).
    </description>
    <url>https://github.com/phisch84/domain-repository</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://github.com/phisch84/domain-repository/blob/master/LICENSE</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Philipp Schosteritsch</name>
            <email>s.philipp@schoste.com</email>
            <url>https://www.schoste.com/</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/phisch84/domain-repository.git</connection>
        <developerConnection>scm:git:https://github.com/phisch84/domain-repository.git</developerConnection>
        <url>https://github.com/phisch84/domain-repository</url>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/phisch84/domain-repository/issues</url>
    </issueManagement>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- compiles against the Java 8 API, even if built with a newer JDK (same baseline as dao) -->
        <java.release.version>8</java.release.version>
        <maven.version>3.15.0</maven.version>
        <maven.jar-plugin.version>3.5.0</maven.jar-plugin.version>
        <maven.surfeire.version>3.5.5</maven.surfeire.version>
        <maven.javadoc-plugin.version>3.11.2</maven.javadoc-plugin.version>
        <versions-maven-plugin.version>2.25.1</versions-maven-plugin.version>
        <junit.version>4.13.2</junit.version>
        <!-- latest Spring version compatible with Java 8 (same as dao) -->
        <spring.version>5.3.39</spring.version>
        <!-- all artifacts of a DAO 4 release have the same version -->
        <dao4.version>4.1.0.RELEASE</dao4.version>
    </properties>

    <!--
    dao4 comes from the GitHub Packages registry of the dao repository. The id is the one of distributionManagement, so that
    one server entry (with a token which may read the dao packages) serves both, also in the GitHub workflows.
    -->
    <repositories>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/phisch84/dao</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>com.schoste.ddd.infrastructure</groupId>
            <artifactId>dao4</artifactId>
            <version>${dao4.version}</version>
        </dependency>
        <dependency>
            <groupId>com.schoste.ddd.infrastructure</groupId>
            <artifactId>dao4-fs-serialization</artifactId>
            <version>${dao4.version}</version>
            <!-- only the integration tests store data objects in files; consumers choose their own storage -->
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.schoste.ddd.infrastructure</groupId>
            <artifactId>dao4</artifactId>
            <version>${dao4.version}</version>
            <classifier>tests</classifier>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Spring (DI/AOP/IoC Framework) dependencies -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-core</artifactId>
            <version>${spring.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>${spring.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <version>${spring.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>domain-repository3</finalName>
        <pluginManagement>
            <plugins>
                <!-- Build and compiler plugin configuration -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.version}</version>
                    <configuration>
                        <release>${java.release.version}</release>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven.jar-plugin.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>test-jar</goal>
                            </goals>
                        </execution>
                    </executions>
                    <!--
                    no Class-Path in the manifest: a library's dependencies are resolved by the application's build
                    (a Class-Path entry only makes javac -Xlint warn about a missing jar)
                    -->
                </plugin>

                <!-- Fixes "tests pass in Eclipse but fail in Maven Surefire -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surfeire.version}</version>
                    <configuration>
                        <reuseForks>false</reuseForks>
                        <forkCount>1</forkCount>
                    </configuration>
                </plugin>

                <!--
                Changes the version: mvn versions:set -DnewVersion=X.Y.Z.RELEASE -DgenerateBackupPoms=false
                -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <version>${versions-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Javadoc of the main and test classes; doclint fails the build on any warning -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven.javadoc-plugin.version}</version>
                <configuration>
                    <release>${java.release.version}</release>
                    <quiet>true</quiet>
                    <failOnWarnings>true</failOnWarnings>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <doclint>all</doclint>
                        </configuration>
                    </execution>
                    <execution>
                        <id>attach-test-javadocs</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <doclint>all,-missing</doclint>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/phisch84/domain-repository</url>
        </repository>
    </distributionManagement>
</project>