<beans 
    xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    
    xsi:schemaLocation="
    http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">
    
    <bean id="DomainObjectRepository" class="com.schoste.ddd.domain.v2.services.standard.DomainObjectRepositoryImpl" scope="singleton" />
	<bean id="DomainObject" class="com.schoste.ddd.domain.v2.models.ExampleDomainObject" scope="prototype" />
	<bean id="UnitOfWork" class="com.schoste.ddd.domain.v2.services.standard.UnitOfWorkImpl" scope="prototype" />
	<bean id="AutoObjectConverter" class="com.schoste.ddd.domain.v2.services.standard.SpringAutoObjectConverterImpl" scope="prototype" />
    <bean id="ExampleDO" class="com.schoste.ddd.domain.v2.dal.models.ExampleDO" scope="prototype" />
    <bean id="ExampleDAO" class="com.schoste.ddd.domain.v2.dal.services.mocked.ExampleDAOImpl" scope="singleton" />
    <bean id="GenericEntityLoader" class="com.schoste.ddd.domain.v2.services.standard.GenericEntityLoaderImpl" scope="prototype" />
</beans>